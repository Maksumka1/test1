# """
# ==============================================================================
# ПІДСУМОК ТА АРХІТЕКТУРНІ ЗАМІТКИ: Dockerfile & docker-compose.yml
# ==============================================================================

# Роль коду в системі:
# "Контейнеризує додаток та інфраструктуру" (DevOps & Infrastructure Deployment Layer).

# Призначення:
# Конфігурація Docker-образу Python 3.11 та оркестрація мультиконтейнерного 
# середовища (FastAPI app + PostgreSQL 16 + Redis 7) для швидкого запуску платформи.

# Ключові паттерни та рішення розробника:
# 1. Синхронізація стартів через Healthchecks:
#    Використання `condition: service_healthy` у `depends_on` гарантує, 
#    що FastAPI-вебсервер заповнюватиме БД тільки після того, як Postgres 
#    підтвердить готовність через `pg_isready`.
# 2. Оптимізований Python runtime:
#    Використання `PYTHONUNBUFFERED=1` для миттєвого стримінгу логів та `slim` 
#    базового образу з очищенням apt-кешу для мінімізації розміру контейнера.
# 3. Персистентність даних (Data Persistence):
#    Збереження стану PostgreSQL у наменованому томі `pgdata` запобігає 
#    втраті фінансової історії при перезапуску контейнерів.
# 4. Легковажні інфраструктурні образи:
#    Використання Alpine-версій для Redis 7 та Postgres 16 для мінімізації 
#    використання системних ресурсів.

# Оцінка коду та покращення:
# - Плюси: Запуск однією командою, надійна перевірка готовності БД, ізоляція.
# - Мінуси: Відсутність Multi-Stage збірки в Dockerfile та запуск контейнера 
#   від імені користувача `root` (варто додати непривілейованого `USER`).
# ==============================================================================
# """


FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
