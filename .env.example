# --- Core services ---
DATABASE_URL=postgresql+psycopg://arbitrage:arbitrage@localhost:5432/arbitrage
REDIS_URL=redis://localhost:6379/0

# --- Operating mode ---
# When SIMULATION_MODE=true the acquisition service generates synthetic OLX
# offers instead of hitting the real network. Set to false only when you have
# working residential/mobile proxies and OLX API credentials.
SIMULATION_MODE=true

# --- Data acquisition (real mode only) ---
# Comma separated list of proxy URLs, e.g. http://user:pass@host:port
OLX_PROXIES=
OLX_POLL_MIN_SECONDS=2
OLX_POLL_MAX_SECONDS=4
# OAuth token / device id required by the limited-phones endpoint (optional)
OLX_OAUTH_TOKEN=
OLX_DEVICE_ID=

# --- Nova Poshta logistics ---
NOVA_POSHTA_API_KEY=
# Ref id of the reseller (recipient) city, e.g. Kyiv
NOVA_POSHTA_RECIPIENT_CITY_REF=8d5a980d-391c-11dd-90d9-001a92567626

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Business defaults ---
# Reseller equity (own capital) used for ROC metric, in UAH
OWNER_EQUITY=100000
# Target sale price factor relative to market price
TARGET_SALE_FACTOR=0.95
